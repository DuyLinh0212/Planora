ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://0.0.0.0:8080

ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=planora;Username=postgres;Password=CHANGE_ME_POSTGRES_PASSWORD;SSL Mode=Prefer
PLANORA_POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD

Jwt__Issuer=Planora.Api
Jwt__Audience=Planora.Frontends
Jwt__Secret=CHANGE_ME_WITH_AT_LEAST_64_RANDOM_BYTES
Jwt__AccessTokenMinutes=15
Jwt__RefreshTokenDays=30

Authentication__Google__ClientId=
Authentication__Google__ClientSecret=
Authentication__Facebook__AppId=
Authentication__Facebook__AppSecret=

Cloudinary__CloudName=
Cloudinary__ApiKey=
Cloudinary__ApiSecret=
Cloudinary__RootFolder=planora

# SMTP fallback for task assignment/update emails when the acting user has not linked Gmail
# or Google temporarily rejects their authorization.
TaskEmailNotifications__FrontendBaseUrl=http://localhost:4200
TaskEmailNotifications__SmtpHost=
TaskEmailNotifications__SmtpPort=587
TaskEmailNotifications__EnableSsl=true
TaskEmailNotifications__Username=
TaskEmailNotifications__Password=
TaskEmailNotifications__FromAddress=
TaskEmailNotifications__FromNameSuffix=via Planora

# Optional per-user Gmail sending. ClientId must be the same public Web OAuth client used
# by the user frontend. Keep ClientSecret and TokenEncryptionKey on the backend only.
GmailIntegration__ClientId=
GmailIntegration__ClientSecret=
GmailIntegration__TokenEncryptionKey=
Storage__MaxFileSizeMb=25

# MoMo payment: use sandbox credentials first, then replace every value with production credentials.
Payment__Momo__PartnerCode=
Payment__Momo__AccessKey=
Payment__Momo__SecretKey=
Payment__Momo__Endpoint=https://test-payment.momo.vn/v2/gateway/api/create
Payment__Momo__ReturnUrl=http://localhost:4200/billing
Payment__Momo__IpnUrl=http://localhost:5273/api/payments/momo/ipn
Payment__Momo__RequestType=captureWallet

# Automatic bank transfer through SePay webhook.
Payment__BankTransfer__BankName=
Payment__BankTransfer__AccountName=
Payment__BankTransfer__AccountNumber=
Payment__BankTransfer__Branch=
Payment__BankTransfer__PaymentReferencePrefix=PLN
Payment__BankTransfer__SePayWebhookApiKey=
Cors__AllowedOrigins__0=http://localhost:3000
Cors__AllowedOrigins__1=http://localhost:3001
RateLimit__PermitLimit=100
RateLimit__WindowSeconds=60

NEXT_PUBLIC_API_URL=http://localhost:8080
